num = int(input("Enter number of knowledge base (KB) statements: "))

KB = []
print("\nEnter each clause in CNF form (use ∨ for OR, ~ for negation).")
print("Example: ~food(x) ∨ likes(John,x)")
for i in range(num):
    clause_str_input = input(f"Clause {i+1}: ").strip()
    KB.append(parse_clause(clause_str_input))

print("\nEnter your query (predicate arg1 arg2 ...), e.g. likes John Peanuts:")
query_input = input("Query: ").strip().split()
query = tuple(query_input)
negated_query = [negate_literal(query)]
KB.append(negated_query)

print("\n------------------------------------------------------")
print("Knowledge Base:")
for idx, clause in enumerate(KB[:-1]):
    print(f"{chr(97+idx)}. {clause_str(clause)}")
print(f"Query (negated): {clause_str(negated_query)}")
print("------------------------------------------------------")

# ---------- Resolution Process ----------

tree = []
step_count = 0
new = set()

while True:
    n = len(KB)
    pairs = [(KB[i], KB[j]) for i in range(n) for j in range(i + 1, n)]
    added_new = False

    for (ci, cj) in pairs:
        resolvent, step = resolve(ci, cj)
        if resolvent is None:
            continue
        step_count += 1
        (c1, c2, l1, l2, subs, new_clause) = step
        tree.append(f"{step_count}. {clause_str(c1)} ⟹ {clause_str(c2)} "
                    f"using {l1} & {l2} with {subs} → {clause_str(new_clause)}")
        if not resolvent:  # Empty clause found
            print("\n------------------------------------------------------")
            print("✅ Proof by Resolution - Stepwise Tree")
            print("------------------------------------------------------")
            for line in tree:
                print(line)
            print("\nHence proved ✅ (Empty clause {})")
            exit()
        resolvent_tuple = tuple(sorted(resolvent))
        if resolvent_tuple not in new:
            new.add(resolvent_tuple)
            added_new = True

    if not added_new:
        print("\n❌ No contradiction found — query cannot be proved.")
        print("\nResolution Steps:")
        for line in tree:
            print(line)
        break

    for c in new:
        if list(c) not in KB:
            KB.append(list(c))
