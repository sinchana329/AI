            print(f"{var} = {val}")

        # Apply substitutions to expr1 (just for illustration)
        def apply_subst(term, subst):
            if is_variable(term) and term in subst:
                return apply_subst(subst[term], subst)
            elif isinstance(term, Function):
                return Function(term.name, [apply_subst(arg, subst) for arg in term.args])
            else:
                return term

        unified_expr = apply_subst(expr1, result)
        print("Unified expression:", unified_expr)
